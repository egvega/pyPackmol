tolerance 2.0
filetype pdb
output bilayer-color.pdb
structure water.pdb
  number 500
  inside box 0. 0. -10. 40. 40. 0.  # color #ff0004
end structure
structure water.pdb
  number 500
  inside box 0. 0. 28. 40. 40. 38.  # color #b700ff
end structure
structure palmitoil.pdb
  number 50
  inside box 0. 0. 0. 40. 40. 14.  # color #0000ff
  atoms 31 32
    below plane 0. 0. 1. 2.  # color #066aff
  end atoms
  atoms 1 2
    over plane 0. 0. 1. 12.  # color #aaaa00
  end atoms
end structure
structure palmitoil.pdb
  number 50
  inside box 0. 0. 14. 40. 40. 28.  # color #10a300
  atoms 1 2
    below plane 0. 0. 1. 16.  # color #aaaa00
  end atoms
  atoms 31 32
    over plane 0. 0. 1. 26  # color #0055ff
  end atoms
end structure
